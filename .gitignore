# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# gsc query reports (`npm run gsc`) and indexing ledger (`npm run gsc:index`)
/reports/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# in-app browser preview scratch dir
.preview/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Near Me data shards: written by etl/aggregate_h3.py, served from Vercel Blob
# (NEXT_PUBLIC_NEARME_DATA_BASE; see README "Near Me data"). Never committed.
/public/data/nearme/
